{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wooloo",
  "version": "0.1.0",
  "identifier": "app.wooloo.win",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "wooloo", "width": 1280, "height": 800, "minWidth": 640, "minHeight": 400 }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "resources": {"../resources/peer-dispatch.ps1": "resources/peer-dispatch.ps1", "../resources/wooloo-sync.exe": "resources/wooloo-sync.exe"}, "targets": "all", "icon": ["icons/icon.ico", "icons/icon.png"] }
}
