{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wooloo",
  "version": "0.1.0",
  "identifier": "app.wooloo.win",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "wooloo",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 400,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu",
        "backgroundColor": "#1e1e2e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../resources/peer-dispatch.ps1": "resources/peer-dispatch.ps1",
      "../resources/wooloo-sync.exe": "resources/wooloo-sync.exe",
      "../resources/herdr_compat.py": "resources/herdr_compat.py",
      "../resources/herdr_client.py": "resources/herdr_client.py",
      "../resources/vt_mini.py": "resources/vt_mini.py",
      "../resources/conpty_mini.py": "resources/conpty_mini.py"
    },
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
